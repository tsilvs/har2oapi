{
	"compilerOptions": {
		"allowArbitraryExtensions": true,
		"declaration": true,
		"declarationMap": true,
		"target": "esnext",
		"module": "preserve",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"rewriteRelativeImportExtensions": true, // why?
		"esModuleInterop": true,
		"rootDir": "src",
		"outDir": "./.build"
	},
	"include": [
		"./src"
	],
	"exclude": [
		"node_modules"
	]
}